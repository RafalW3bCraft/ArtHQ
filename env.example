# Public Firebase web configuration (safe to bundle; not server credentials).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_USE_FIREBASE_EMULATOR=false

# Server Firestore project. Use arthq-tech; on Cloud Run use a service identity
# with Firestore access.
# Locally run: gcloud auth application-default login
# Use your Firebase project ID below; do not rely on an unrelated gcloud default project.
# Expired credentials require signing in again. Alternatively use ONE credential method:
# FIREBASE_SERVICE_ACCOUNT_KEY accepts JSON or base64 JSON; GOOGLE_APPLICATION_CREDENTIALS
# is a local path to a service-account JSON file. Keep these credentials out of Git.
FIREBASE_PROJECT_ID=arthq-tech
FIREBASE_SERVICE_ACCOUNT_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# Server-only AI key. Models are pinned to MiniMax M3 and Kimi K3 in shared/business.ts.
FEATHERLESS_API_KEY=

# Razorpay setup (server-only; never prefix these secrets with VITE_):
# 1. In Razorpay Dashboard select Test mode, then generate API keys under
#    Account & Settings > API Keys. Copy the matching ID and secret below.
# 2. Deploy the API behind your site's HTTPS domain before creating a webhook.
#    This project's Firebase Hosting /api/** rewrite targets Cloud Run service
#    rafalwebcraft-api in asia-south1 within Firebase project arthq-tech.
#    Keep that service and this file's rewrite in sync when changing either.
# 3. Account & Settings > Website and app settings > Webhooks > Add New Webhook.
#    URL: https://YOUR_DOMAIN/api/payments/webhook
#    Local testing needs a public HTTPS tunnel to port 5000; localhost will not work.
# 4. Generate a separate random webhook secret (for example: openssl rand -hex 32).
#    Enter exactly the same value in the dashboard and RAZORPAY_WEBHOOK_SECRET.
#    This is NOT your RAZORPAY_KEY_SECRET. Add an alert email and enable the webhook.
# 5. Subscribe to payment.captured and refund.processed. Enable automatic payment
#    capture in Razorpay: authorisation alone does not mark a project as paid.
# 6. Save these server variables and restart/redeploy the API. In /admin publish
#    your packages, address and refund terms, then approve the business settings.
# 7. Complete a test booking, confirm webhook delivery returns HTTP 2xx and the
#    project shows paid. Redelivering the event must not charge or credit twice.
#    Test a full refund too. Invalid webhook signatures must return HTTP 400.
# 8. For launch, switch to Live mode, create LIVE API keys and a separate live
#    webhook/secret for the production URL, then update/redeploy the API again.
#    Never mix test orders and live keys. Monitor webhook failures in the dashboard.
#    Razorpay retries failed delivery for 24 hours and may disable failing webhooks.
# Setup reference: https://razorpay.com/docs/webhooks/setup-edit-payments/
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

PORT=5000
NODE_ENV=development
# Package prices, address, cancellation terms, and social links are managed in /admin.
# Run npm run admin:set -- FIREBASE_USER_UID once using your authorized server identity.
