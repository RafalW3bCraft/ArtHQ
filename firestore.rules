rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function staff() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function text(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max && value.matches('(?s).*\\S.*');
    }
    function owned(data) { return signedIn() && data.userId == request.auth.uid; }
    function timestamp(value) { return value is int && value > 0 && value <= request.time.toMillis() + 300000; }
    function statusEdit() {
      let d = request.resource.data;
      return staff() && d.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && timestamp(d.updatedAt);
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || staff());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','email','companyName','phoneNumber','role','createdAt'])
        && request.resource.data.uid == uid && request.resource.data.role == 'user'
        && request.resource.data.email == request.auth.token.email
        && text(request.resource.data.companyName,1,120) && text(request.resource.data.phoneNumber,1,40)
        && timestamp(request.resource.data.createdAt);
    }
    match /projects/{id} {
      allow read: if owned(resource.data) || staff();
      allow create: if owned(request.resource.data) && validBrief(request.resource.data);
      function validBrief(d) {
        return d.keys().hasOnly(['userId','serviceType','projectName','description','timeline','budget','status','createdAt','updatedAt'])
          && d.serviceType in ['website','telegram-bot','ai-assistant','mobile-app','e-commerce','other']
          && text(d.projectName,1,120) && text(d.description,10,4000)
          && d.get('budget','') is string && d.get('budget','').size() <= 120
          && d.get('timeline','') is string && d.get('timeline','').size() <= 120
          && d.status == 'pending' && timestamp(d.createdAt) && d.createdAt == d.updatedAt;
      }
      allow update: if statusEdit() && ((resource.data.status == 'pending' && request.resource.data.status in ['in-progress','cancelled'])
        || (resource.data.status == 'in-progress' && request.resource.data.status in ['completed','cancelled']));
    }
    match /support_messages/{id} {
      allow read: if owned(resource.data) || staff();
      allow create: if owned(request.resource.data) && validTicket(request.resource.data);
      function validTicket(d) {
        return d.keys().hasOnly(['userId','subject','message','status','createdAt','updatedAt'])
          && text(d.subject,1,120) && text(d.message,10,4000)
          && d.status == 'open' && timestamp(d.createdAt) && d.createdAt == d.updatedAt;
      }
      allow update: if statusEdit() && ((resource.data.status == 'open' && request.resource.data.status == 'in-progress')
        || (resource.data.status == 'in-progress' && request.resource.data.status == 'resolved'));
    }
    match /contact_submissions/{id} {
      allow create: if validEnquiry(request.resource.data);
      function validEnquiry(d) {
        return d.keys().hasOnly(['name','email','message','status','createdAt'])
          && text(d.name,2,120) && text(d.email,3,254) && d.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
          && text(d.message,10,4000) && d.status == 'new' && timestamp(d.createdAt);
      }
      allow read: if staff();
      allow update: if staff() && (
        (resource.data.status == 'new' && request.resource.data.status == 'read' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        || (resource.data.status == 'read' && request.resource.data.status == 'responded' && timestamp(request.resource.data.respondedAt)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','respondedAt'])));
    }
  }
}
