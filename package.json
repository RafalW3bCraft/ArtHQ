{
  "name": "arthq",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build",
    "start": "vite preview --host 0.0.0.0",
    "test:rules": "node --test tests/firestore.test.mjs",
    "test:browser": "node tests/portal.e2e.mjs",
    "deploy:firebase": "node scripts/check-firebase-env.mjs && npm run build && firebase deploy --only auth,firestore:rules,firestore:indexes,hosting --project arthq-tech",
    "preview:firebase": "node scripts/check-firebase-env.mjs && npm run build && firebase hosting:channel:deploy preview --expires 7d --project arthq-tech"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "wouter": "^3.3.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright-core": "^1.65.1",
    "typescript": "~5.9.0",
    "vite": "^7.3.8"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}
